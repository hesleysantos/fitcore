# Cabeçalhos de segurança para hospedagem estática (Netlify e Cloudflare Pages leem este arquivo).
# connect-src é 'self' aqui porque este cabeçalho também vale para o service worker (sw.js), que baixa os
# arquivos do próprio site para o uso offline. A página em si continua com connect-src 'none' (index.html).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self' blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types fitcore-sw
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), interest-cohort=()

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
